# ==============================================================================
# CONFIG SAMPLE: Go-Mirror-Bot
# Salin file ini menjadi config.env jika deploy lokal / VPS,
# atau masukkan variabel di bawah ini ke Environment Variables Koyeb / Heroku.
# ==============================================================================

# [WAJIB] Token Bot Telegram dari @BotFather
BOT_TOKEN=""

# [WAJIB] ID Telegram Anda sebagai Pemilik Bot (bisa cek via @userinfobot)
OWNER_ID=""

# [OPSIONAL] Daftar ID Chat/Grup yang diizinkan (pisahkan dengan spasi)
# Contoh: AUTHORIZED_CHATS="-1001234567890 8257809862"
AUTHORIZED_CHATS=""

# [OPSIONAL] Daftar ID Pengguna Sudo yang diizinkan (pisahkan dengan spasi)
SUDO_USERS=""

# [OPSIONAL] Direktori unduhan sementara (default: "downloads")
DOWNLOAD_DIR="downloads"

# [OPSIONAL] Remote & folder tujuan Rclone untuk perintah /mirror
# Contoh: "mygdrive:Mirror" atau "mega:Downloads"
RCLONE_PATH=""

# [OPSIONAL] Port HTTP Web Server untuk Health Check Koyeb (default: 8080)
PORT="8080"
