# ==============================================================================
# CONFIG SAMPLE: WZML-X Go (1:1 Porting)
# Salin file ini menjadi config.env jika deploy lokal / VPS,
# atau masukkan variabel di bawah ini ke Environment Variables Koyeb / Heroku.
# ==============================================================================

# [WAJIB] Token Bot Telegram dari @BotFather
BOT_TOKEN=""

# [WAJIB] ID Telegram Pemilik Bot (bisa cek via @userinfobot)
OWNER_ID=""

# [TELEGRAM MTPROTO / WZGRAM] API ID & API Hash dari https://my.telegram.org
TELEGRAM_API=""
TELEGRAM_HASH=""

# [OPSIONAL] User Session String untuk Userbot / Premium Leech (>2GB)
USER_SESSION_STRING=""

# [OPSIONAL] Daftar ID Chat/Grup yang diizinkan (pisahkan dengan spasi)
# Contoh: AUTHORIZED_CHATS="-1001234567890 8257809862"
AUTHORIZED_CHATS=""

# [OPSIONAL] Daftar ID Pengguna Sudo yang diizinkan (pisahkan dengan spasi)
SUDO_USERS=""

# [OPSIONAL] Mode default upload untuk perintah /mirror: "rc" (Rclone) atau "ddl" (Pixeldrain)
DEFAULT_UPLOAD="rc"

# [OPSIONAL] API Key Pixeldrain untuk DDL upload (https://pixeldrain.com/user/api_keys)
PIXELDRAIN_API=""

# [OPSIONAL] Direktori unduhan sementara (default: "downloads")
DOWNLOAD_DIR="downloads"

# [OPSIONAL] Remote & folder tujuan Rclone untuk perintah /mirror
# Contoh: "mygdrive:Mirror" atau "mega:Downloads"
RCLONE_PATH=""

# [OPSIONAL] Port HTTP Web Server untuk Health Check Koyeb (default: 8080)
PORT="8080"

# [OPSIONAL] Google Drive Tools
GDRIVE_ID=""
INDEX_URL=""
USE_SERVICE_ACCOUNTS="False"
IS_TEAM_DRIVE="False"
STOP_DUPLICATE="False"
DISABLE_DRIVE_LINK="False"
GD_INFO="Uploaded by WZML-X Go"

